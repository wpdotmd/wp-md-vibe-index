{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wpdotmd/wp-md-vibe-index/blob/main/data/schema.json",
  "title": "vibe-code index record",
  "type": "object",
  "required": [
    "slug",
    "name",
    "moat",
    "moatTags",
    "verdict",
    "build",
    "upkeepHoursPerYear",
    "couldBuild",
    "stillMissing",
    "requirements",
    "confidence"
  ],
  "additionalProperties": true,
  "properties": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Must match the filename and the plugin's detail slug on wp.md."
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "moat": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100,
      "description": "Share of the product that is NOT code you could commission."
    },
    "moatTags": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "enum": [
          "data",
          "service",
          "ai",
          "network",
          "compliance",
          "updates",
          "support",
          "library"
        ]
      }
    },
    "verdict": {
      "enum": [
        "yes",
        "kinda",
        "no",
        "never"
      ],
      "description": "Derived from moat — do not hand-edit. 0-33 yes, 34-57 kinda, 58-74 no, 75+ never."
    },
    "build": {
      "enum": [
        "sitting",
        "weekend",
        "weekends",
        "months"
      ],
      "description": "Time to a usable MVP with a current coding agent."
    },
    "upkeepHoursPerYear": {
      "type": "integer",
      "minimum": 0,
      "maximum": 200
    },
    "couldBuild": {
      "type": "string",
      "minLength": 20
    },
    "stillMissing": {
      "type": "string",
      "minLength": 20
    },
    "requirements": {
      "type": "array",
      "minItems": 3,
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 10
      }
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    },
    "reviewedOn": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "derived": {
      "type": "object",
      "description": "Regenerated by `wp ptp vibe_export`. Edits here are overwritten.",
      "additionalProperties": true
    },
    "confidence": {
      "enum": [
        "high",
        "medium",
        "low"
      ],
      "description": "How sure we are of the moat score. Low means the relative placement against similar products is genuinely arguable."
    },
    "alternatives": {
      "type": "array",
      "maxItems": 6,
      "description": "Free or open-source options that already do the job. Must be finished, installable and actually free.",
      "items": {
        "type": "object",
        "required": [
          "name",
          "url",
          "type",
          "desc"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "pattern": "^https?://"
          },
          "type": {
            "enum": [
              "free-tier",
              "open-source",
              "alternative"
            ]
          },
          "desc": {
            "type": "string",
            "minLength": 15
          }
        }
      }
    },
    "crossRef": {
      "type": "array",
      "maxItems": 4,
      "description": "How other public indexes rate the same product. Disagreement is the interesting case — say why.",
      "items": {
        "type": "object",
        "required": [
          "source",
          "url",
          "verdict",
          "note"
        ],
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "pattern": "^https?://"
          },
          "verdict": {
            "type": "string",
            "minLength": 1
          },
          "note": {
            "type": "string",
            "minLength": 20
          }
        }
      }
    },
    "buildHours": {
      "type": "integer",
      "minimum": 1,
      "maximum": 200,
      "description": "Hours behind the build bucket, used by the money model. 2/6/16/50 for sitting/weekend/weekends/months."
    }
  }
}
